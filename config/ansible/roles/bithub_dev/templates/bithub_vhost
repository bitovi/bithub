server {
    listen  80;
    #listen  [::]:80 default ipv6only=on;

    #listen 443 ssl;
    #ssl_certificate    /etc/ssl/localcerts/bithub.pem;
    #ssl_certificate_key /etc/ssl/localcerts/bithub.key;

    access_log /var/log/nginx/bithub.loc.access.log;
    error_log  /var/log/nginx/bithub.loc.error.log;

    server_name *.bithub.loc;

    location /socket.io/ {
         proxy_pass http://127.0.0.1:3002;
         proxy_http_version 1.1;
         proxy_set_header Upgrade $http_upgrade;
         proxy_set_header Connection "Upgrade";
    }

    location / {
         try_files $uri @api;
    }

    location @api {
        proxy_pass          http://unix:/tmp/bithub_unicorn.sock;
    	proxy_redirect      off;

        proxy_set_header    Host             $host;
        proxy_set_header    X-Real-IP        $remote_addr;
        proxy_set_header    X-Forwarded-For  $proxy_add_x_forwarded_for;
    }
}