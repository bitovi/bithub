namespace :deploy do

  desc "Export upstart scripts"
  task :export do
    on roles(:all) do |host|

      options = []
      options << "--app bithub"
      options << "--log #{fetch(:log_path)}"
      options << "--user #{fetch(:user)}"
      options << "--env #{fetch(:current_path)}/.env_#{fetch(:stage)}"
      options << "--template #{fetch(:current_path)}/config/capistrano/tasks/templates"
      options << "--procfile #{fetch(:current_path)}/Procfile.#{fetch(:stage)}"

      dst = "/lib/systemd/system/"

      within fetch(:release_path) do
        capture "sudo foreman export #{options.join(' ')} systemd #{dst}"
      end

      execute 'sudo systemctl daemon-reload'
    end
  end

  namespace :liveservice do
    desc "NPM install"
    task :npm_install do
      on roles(:all) do |host|
        within release_path.join('services/liveservice') do
          execute :npm, 'install', '--production', '--no-spin'
        end
      end
    end
  end

  namespace :client do
    desc 'Run all subtasks for client'
    task :build => [
      'deploy:client:npm_install',
      'deploy:client:bower_install',
      'deploy:client:steal_build',
      'deploy:client:embed_build',
      'deploy:client:frontpage_hub_npm_install',
      'deploy:client:frontpage_hub_build'
    ]

    desc "NPM install"
    task :npm_install do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute :npm, 'install', '--production', '--no-spin'
        end
      end
    end

    desc "Bower install"
    task :bower_install do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute :bower, 'install', '--quiet', '--config.interactive=false'
        end
      end
    end

    desc "Steal build"
    task :steal_build do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute './node_modules/steal-tools/bin/steal', 'build', '--config=stealconfig.js', '--main=bithub-social'
        end
      end
    end

    desc "Embed build"
    task :embed_build do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute './node_modules/steal-tools/bin/steal', 'build', '--config=stealconfig.js', '--main=bithub-embed'
        end
      end
    end

    desc "Frontpage Hub NPM install"
    task :frontpage_hub_npm_install do
      on roles(:all) do |host|
        within release_path.join('public', 'homepage_embed') do
          execute :npm, 'install', '--production', '--no-spin'
        end
      end
    end

    desc "Frontpage Hub build"
    task :frontpage_hub_build do
      on roles(:all) do |host|
        within release_path.join('public', 'homepage_embed') do
          execute './node_modules/steal-tools/bin/steal', 'build', '--main=index'
        end
      end
    end
  end

  task :client => ['deploy:client:build']

  after :finishing, 'deploy:export'
  after :finishing, 'deploy:liveservice:npm_install'
  after :finishing, 'deploy:client'
end
