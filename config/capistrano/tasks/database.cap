namespace :db do

  desc "Sync Staging with Production"
  task :sync_with_production do
    on 'root@bithub.com', in: :sequence do |host|
      as :postgres do
        execute :pg_dump,
          "--verbose",
          "--no-password",
          "--format=custom",
          "bithub > /pg_dumps/sync.dump"

        execute :scp, "/pg_dumps/sync.dump", "192.168.143.36:/pg_dumps/sync.dump"
      end
    end

    on 'root@staging.bithub.com' do
      as :postgres do
        execute :pg_restore,
          "--verbose",
          "--no-password",
          "--clean",
          "--if-exists",
          "--format=custom",
          "--dbname=bithub",
          "/pg_dumps/sync.dump"
      end
    end
  end
  
  desc "Pull DB from current stage"
  task :pull do
    on roles(:db) do |host|
      backup_filename = gen_backup_version + fetch(:backup_ext)
      local_backup_dest = File.join('.', 'tmp', backup_filename)
      remote_backup_dest = File.join('/', 'tmp', backup_filename)

      # dump, download & cleanup
      execute :pg_dump,
        "--no-password",
        "--format=custom",
        "bithub > #{remote_backup_dest}"

      download! remote_backup_dest, local_backup_dest
      execute :rm, remote_backup_dest

      # load the database with: pg_restore --dbname --clean --if-exists bithub_development {local_backup_dest}
    end
  end


  desc "Backup database"
  task :backup do
    backup_dest = File.join fetch(:backup_path), (gen_backup_version + fetch(:backup_ext))

    on roles(:db) do |host|
      execute :pg_dump,
        "--no-password",
        "--format=custom",
        "bithub > #{backup_dest}"
    end
  end

  desc "Restore database from provided backup"
  task :restore do
    on roles(:db) do |host|
      list = capture :ls, '-1tr', File.join(fetch(:backup_path), '*' + fetch(:backup_ext))
      versions = list.split(/\r?\n/).map {|f| File.basename(f, fetch(:backup_ext))}

      ask :version, versions.last
      (error "Given backup does not exists!" and exit) unless versions.include? fetch(:version)

      restore_path = File.join(fetch(:backup_path), version + fetch(:backup_ext))
      execute :pg_restore,
        '--clean',
        '--if-exists',
        '--format=custom',
        "--dbname=bithub",
        restore_path
    end
  end
end
