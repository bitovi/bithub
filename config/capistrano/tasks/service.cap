namespace :start do

  namespace :web do
    desc "Start rails"
    task :rails do
      on roles(:all) do |host|
        capture("sudo systemctl start bithub-rails-1.service")
      end
    end

    desc "Start ssr"
    task :ssr do
      on roles(:all) do |host|
        capture("sudo systemctl start bithub-ssr-1.service")
      end
    end
  end

  task :web => ['start:web:rails', 'start:web:ssr']

  desc "Start sidekiq"
  task :sidekiq do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-sidekiq-1.service")
    end
  end

  desc "Start listener"
  task :listener do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-listener-1.service")
    end
  end

  desc "Start liveservice"
  task :liveservice do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-liveservice-1.service")
    end
  end

  desc "Start crawler_poller"
  task :crawler_poller do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-crawler_poller-1.service")
    end
  end

  desc "Start crawler_streamer"
  task :crawler_streamer do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-crawler_streamer-1.service")
    end
  end

  desc "Start crawler_listener"
  task :crawler_listener do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-crawler_listener-1.service")
    end
  end

  task :all => [
    'start:web',
    'start:sidekiq',
    'start:listener',
    'start:liveservice',
    'start:crawler_poller',
    # 'start:crawler_listener'
  ]

end

namespace :stop do

  namespace :web do
    desc "Stop rails"
    task :rails do
      on roles(:all) do |host|
        capture("sudo systemctl stop bithub-rails-1.service")
      end
    end

    desc "Stop ssr"
    task :ssr do
      on roles(:all) do |host|
        capture("sudo systemctl stop bithub-ssr-1.service")
      end
    end
  end

  task :web => ['stop:web:rails', 'stop:web:ssr']
  
  desc "Stop sidekiq"
  task :sidekiq do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-sidekiq-1.service")
    end
  end
  
  desc "Stop listener"
  task :listener do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-listener-1.service")
    end
  end
  
  desc "Stop liveservice"
  task :liveservice do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-liveservice-1.service")
    end
  end

  desc "Stop crawler_listener"
  task :crawler_listener do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-crawler_listener-1.service")
    end
  end

  desc "Stop crawler poller"
  task :crawler_poller do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-crawler_poller-1.service")
    end
  end

  desc "Stop crawler_streamer"
  task :crawler_streamer do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-crawler_streamer-1.service")
    end
  end
  
  task :all => [
    'stop:web',
    'stop:sidekiq',
    'stop:listener',
    'stop:liveservice',
    'stop:crawler_poller',
    # 'stop:crawler_listener'
  ]
end

namespace :restart do

  namespace :web do
    desc "Restart rails"
    task :rails do
      on roles(:all) do |host|
        capture("sudo systemctl restart bithub-rails-1.service")
      end
    end

    desc "Restart ssr"
    task :ssr do
      on roles(:all) do |host|
        capture("sudo systemctl restart bithub-ssr-1.service")
      end
    end
  end

  desc 'Restart everyting needed for web'
  task :web => ['restart:web:rails', 'restart:web:ssr']

  desc "Restart sidekiq"
  task :sidekiq do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-sidekiq-1.service")
    end
  end

  desc "Restart listener"
  task :listener do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-listener-1.service")
    end
  end

  desc "Restart liveservice"
  task :liveservice do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-liveservice-1.service")
    end
  end

  desc "Restart crawler_poller"
  task :crawler_poller do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-crawler_poller-1.service")
    end
  end

  desc "Restart crawler_streamer"
  task :crawler_streamer do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-crawler_streamer-1.service")
    end
  end

  desc "Restart crawler_listener"
  task :crawler_listener do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-crawler_listener-1.service")
    end
  end

  task :all => [
    'restart:web',
    'restart:sidekiq',
    'restart:listener',
    'restart:liveservice',
    'restart:crawler_poller',
    # 'restart:crawler_listener'
  ]

end
