server {
        listen *:80;
        server_name {{ domain }};

        # listen 443 ssl;
        # ssl_certificate         /etc/ssl/localcerts/bithub.pem;
        # ssl_certificate_key     /etc/ssl/localcerts/bithub.key;

        access_log /var/log/nginx/{{ domain }}.access.log;
        error_log  /var/log/nginx/{{ domain }}.error.log;

        root {{ bithub.project_path }}/web/current/public;
        index index.html;

        location /socket.io/ {
                proxy_pass http://127.0.0.1:3002;
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";
                proxy_read_timeout 999999999;
        }

        location /api/postback {
                proxy_pass                      http://127.0.0.1:3001;
                proxy_redirect                  off;

                proxy_set_header                Host             $host;
                proxy_set_header                X-Real-IP        $remote_addr;
                proxy_set_header                X-Forwarded-For  $proxy_add_x_forwarded_for;
        }

        location / {
                try_files $uri @rails;
        }

        location @rails {
                proxy_pass                      http://unix:{{ bithub.project_path }}/web/shared/sockets/unicorn.sock;
                proxy_redirect                  off;

                proxy_set_header                Host             $host;
                proxy_set_header                X-Real-IP        $remote_addr;
                proxy_set_header                X-Forwarded-For  $proxy_add_x_forwarded_for;
        }
}