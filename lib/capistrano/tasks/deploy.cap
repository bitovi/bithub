namespace :deploy do

  desc "Preparation tasks"
  task :prepare do
    on roles(:all) do |host|
      within fetch(:shared_path) do
        execute :mkdir, '-p', 'pids', 'sockets', 'log'
      end
    end
  end

  desc "Export upstart scripts"
  task :export do
    on roles(:all) do |host|

      options = []
      options << "--app bithub"
      options << "--log #{fetch(:log_path)}"
      options << "--user #{fetch(:user)}"
      options << "--env #{fetch(:current_path)}/.env_#{fetch(:stage)}"
      options << "--template #{fetch(:current_path)}/lib/capistrano/tasks/templates"
      options << "--procfile #{fetch(:current_path)}/Procfile.#{fetch(:stage)}"

      dst = "/lib/systemd/system/"

      within fetch(:release_path) do
        capture "sudo foreman export #{options.join(' ')} systemd #{dst}"
      end

      execute 'sudo systemctl daemon-reload'
    end
  end

  namespace :liveservice do
    desc "NPM install"
    task :npm_install do
      on roles(:all) do |host|
        within release_path.join('services/liveservice') do
          execute :npm, 'install', '--production', '--silent'
        end
      end
    end
  end

  namespace :client do
    desc "NPM install"
    task :npm_install do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute :npm, 'install', '--production', '--silent'
        end
      end
    end

    desc "Bower install"
    task :bower_install do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute :bower, 'install', '--quite', '--config.interactive=false'
        end
      end
    end

    desc "Steal build"
    task :steal_build do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute './node_modules/steal-tools/bin/steal', 'build', '--config=stealconfig.js', '--main=bithub-social'
        end
      end
    end

    desc "Embed build"
    task :embed_build do
      on roles(:all) do |host|
        within release_path.join('public') do
          execute './node_modules/steal-tools/bin/steal', 'build', '--config=stealconfig.js', '--main=bithub-embed'
        end
      end
    end
  end

  after :finishing, 'deploy:prepare'
  after :finishing, 'deploy:export'
  after :finishing, 'deploy:liveservice:npm_install'
  after :finishing, 'deploy:client:npm_install'
  after :finishing, 'deploy:client:bower_install'
  after :finishing, 'deploy:client:steal_build'
  after :finishing, 'deploy:client:embed_build'
end
