namespace :deploy do

  desc "Export upstart scripts"
  task :export do
    on roles(:all) do |host|

      options = []
      options << "--app bithub"
      options << "--log #{fetch(:log_path)}"
      options << "--user #{fetch(:user)}"
      options << "--env #{fetch(:current_path)}/.env_#{fetch(:stage)}"
      options << "--procfile #{fetch(:current_path)}/Procfile.#{fetch(:stage)}"
      dst = '/etc/init'

      within fetch(:current_path) do
        capture :foreman, :export, options, :upstart, dst
      end
    end
  end

  after 'deploy:updated', 'deploy:export'
end
