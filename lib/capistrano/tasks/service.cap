### Web API

namespace :web do
  desc "Stop web"
  task :stop do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-web-1.service")
    end
  end

  desc "Start web"
  task :start do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-web-1.service")
    end
  end

  desc "Restart web"
  task :restart do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-web-1.service")
    end
  end
end


