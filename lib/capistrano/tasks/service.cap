### Web API

namespace :web do
  desc "Stop web"
  task :stop do
    on roles(:all) do |host|
      capture("sudo service bithub-web stop")
    end
  end

  desc "Start web"
  task :start do
    on roles(:all) do |host|
      capture("sudo service bithub-web start")
    end
  end

  desc "Restart web"
  task :restart do
    on roles(:all) do |host|
      capture("sudo service bithub-web restart")
    end
  end
end


