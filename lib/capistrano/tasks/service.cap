### Live service

namespace :liveservice do
  desc "Stop live systemctl"
  task :stop do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-liveservice-1.service")
    end
  end

  desc "Start live systemctl"
  task :start do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-liveservice-1.service")
    end
  end

  desc "Restart live systemctl"
  task :restart do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-liveservice-1.service")
    end
  end
end
