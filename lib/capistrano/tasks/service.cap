namespace :start do
  
  desc "Start web"
  task :web do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-web-1.service")
    end
  end
  
  desc "Start worker"
  task :worker do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-worker-1.service")
    end
  end

  desc "Start listener"
  task :listener do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-listener-1.service")
    end
  end

  desc "Start liveservice"
  task :liveservice do
    on roles(:all) do |host|
      capture("sudo systemctl start bithub-liveservice-1.service")
    end
  end
  
  namespace :crawler do
    desc "Start crawler poller"
    task :poller do
      on roles(:all) do |host|
        capture("sudo systemctl start bithub-crawler_poller-1.service")
      end
    end

    desc "Start crawler streamer"
    task :streamer do
      on roles(:all) do |host|
        capture("sudo systemctl start bithub-crawler_streamer-1.service")
      end
    end

    desc "Start crawler listener"
    task :listener do
      on roles(:all) do |host|
        capture("sudo systemctl start bithub-crawler_listener-1.service")
      end
    end
  end
end

namespace :stop do

  desc "Stop web"
  task :web do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-web-1.service")
    end
  end
  
  desc "Stop worker"
  task :worker do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-worker-1.service")
    end
  end
  
  desc "Stop listener"
  task :listener do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-listener-1.service")
    end
  end
  
  desc "Stop liveservice"
  task :liveservice do
    on roles(:all) do |host|
      capture("sudo systemctl stop bithub-liveservice-1.service")
    end
  end

  namespace :crawler do
    desc "Stop crawler listener"
    task :listener do
      on roles(:all) do |host|
        capture("sudo systemctl stop bithub-crawler_listener-1.service")
      end
    end

    desc "Stop crawler poller"
    task :poller do
      on roles(:all) do |host|
        capture("sudo systemctl stop bithub-crawler_poller-1.service")
      end
    end

    desc "Stop crawler streamer"
    task :streamer do
      on roles(:all) do |host|
        capture("sudo systemctl stop bithub-crawler_streamer-1.service")
      end
    end
  end
end

namespace :restart do

  desc "Restart web"
  task :web do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-web-1.service")
    end
  end
  
  desc "Restart worker"
  task :worker do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-worker-1.service")
    end
  end
  
  desc "Restart listener"
  task :listener do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-listener-1.service")
    end
  end

  desc "Restart liveservice"
  task :liveservice do
    on roles(:all) do |host|
      capture("sudo systemctl restart bithub-liveservice-1.service")
    end
  end
  
  namespace :crawler do
    desc "Restart crawler poller"
    task :poller do
      on roles(:all) do |host|
        capture("sudo systemctl restart bithub-crawler_poller-1.service")
      end
    end

    desc "Restart crawler streamer"
    task :streamer do
      on roles(:all) do |host|
        capture("sudo systemctl restart bithub-crawler_streamer-1.service")
      end
    end

    desc "Restart crawler listener"
    task :listener do
      on roles(:all) do |host|
        capture("sudo systemctl restart bithub-crawler_listener-1.service")
      end
    end
  end
end
