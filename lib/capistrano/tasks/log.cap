namespace :log do

  desc "Tail listener log"
  task :listener do
    on roles(:app) do |host|
      execute :tail, '-f', File.join(fetch(:log_path), 'listener.log')
    end
  end

  desc "Tail worker log"
  task :worker do
    on roles(:app) do |host|
      execute :tail, '-f', File.join(fetch(:log_path), 'worker.log')
    end
  end

  desc "Tail crawler log"
  task :crawler do
    on roles(:app) do |host|
      execute :tail, '-f', File.join(fetch(:log_path), 'crawler.log')
    end
  end

  desc "Tail IRC bot log"
  task :ircbot do
    on roles(:app) do |host|
      execute :tail, '-f', File.join(fetch(:log_path), 'irc_bot.log')
    end
  end

  desc "Tail liveservice log"
  task :liveservice do
    on roles(:app) do |host|
      execute :tail, '-f', File.join(fetch(:log_path), 'liveservice.log')
    end
  end

  desc "Tail unicorn log"
  task :unicorn do
    on roles(:app) do |host|
      execute :tail, '-f', File.join(fetch(:log_path), 'unicorn.log')
    end
  end

  namespace :web do
    desc "Tail rails log"
    task :rails do
      on roles(:app) do |host|
        execute :tail, '-f', File.join(fetch(:log_path), 'rails.log')
      end
    end

    desc "Tail ActiveRecord log"
    task :active_record do
      on roles(:app) do |host|
        execute :tail, '-f', File.join(fetch(:log_path), 'active_record.log')
      end
    end

    desc "Tail ActionController log"
    task :action_controller do
      on roles(:app) do |host|
        execute :tail, '-f', File.join(fetch(:log_path), 'action_controller.log')
      end
    end

  end
end
