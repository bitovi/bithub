web: bundle exec unicorn_rails -c ./config/unicorn.rb
listener: bundle exec ruby ./services/listener/listener.rb
crawler_poller: NEW_RELIC_APP_NAME="Bithub-Crawler/Poller (Testing)" bundle exec ruby ./services/crawler/poller/kickstart.rb
crawler_listener: NEW_RELIC_APP_NAME="Bithub-Crawler/Listener (Testing)" bundle exec ruby ./services/crawler/listener/kickstart.rb
liveservice: NEW_RELIC_APP_NAME="Bithub-LiveService (Testing)" nodejs ./services/liveservice/server.js
worker: bundle exec sidekiq
