<div class="column-wrapper clearfix columns-{{columnCount}}">
    {{#each columns}}
    <div class="column">
        {{#each this}}
        <bh-bit bit="{.}" state="{state}" class="{{#unless @hasExplicitHeight}}animate-height{{/unless}} {{#unless @isLoaded}}loading{{/unless}}"></bh-bit>
        {{/each}}
    </div>
    {{/each}}

</div>

{{#if isLoading}}
	<div class="loader">
		<i class="fa-circle-o-notch fa fa-spin"></i>
	</div>
{{/if}}

{{#if state.showPoweredBy}}
	<div class="powered-by">
		Powered by <a href="http://bithub.com" target="_blank">BitHub</a>
	</div>
{{/if}}
