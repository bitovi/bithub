{{#bit}}
	{{#if state.isAdmin}}
		<div class="admin-panel">
			<div class="disapprove-approve" can-click="toggleApproveBit">
				<i class="fa fa-thumbs-{{#is_approved}}down{{else}}up{{/is_approved}}"></i>
				<div class="action-is">
					{{#is_approved}}
						Block
					{{else}}
						Approve
					{{/is_approved}}
				</div>
			</div>
		
			<div class="pin" can-click="togglePinBit">
				<i class="fa-thumb-tack fa"></i>
				{{#is_pinned}}
					<i class="fa fa-remove"></i>
				{{/is_pinned}}
				<div class="action-is">
					{{#is_pinned}}
						Unpin
					{{else}}
						Pin
					{{/is_pinned}}
				</div>
			</div>
			
		</div>
	{{/if}}
	<div class="bit">
		<div class="bit-content col-sm-12">

			{{#if isTumblrImage}}
				<bh-image-gallery images="{images}"></bh-image-gallery>
			{{else}}
				{{#if images.length}}
					<div class="image-wrap">
						{{#each images}}
						<img src="{{url}}">
						{{/each}}
					</div>
				{{/if}}
			{{/if}}

			<bh-body-wrap class="{{#if images.length}}short{{else}}tall{{/if}}">
				<h4>{{{ formattedTitle title }}}</h4>

				{{#if body}}
				<figcaption class="bit-content--caption">
					{{{ body }}}
				</figcaption>
				{{/if}}
			</bh-body-wrap>


		</div>
		<footer class="bit-footer col-sm-12">
			{{#author.avatar_url}}
			<figure class="bit-avatar">
				<a href="{{url}}">
					<img class="bit-avatar--img img-responsive" src="{{.}}" />
				</a>
			</figure>
			{{/author.avatar_url}}
			<figcaption>
				{{#author.id}}
				<div class="bit-authorName"><a href="{{url}}">{{.}}</a></div>
				{{/author.id}}
				{{#unless isTwitterFollow}}
				<div class="bit-created-at">
					{{formattedThreadUpdatedAt}}
				</div>
				{{/unless}}
			</figcaption>
			<a href="{{url}}" class="bh-icon bh-icon-{{feed_name}}"></a>
		</footer>
	</div>
{{/bit}}