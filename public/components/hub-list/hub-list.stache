<h2>Bitovi Hubs</h2>
{{#if hubs.isPending}}
	<div class="alert alert-info">Loading...</div>
{{else}}
	{{#if hubs.length}}
		<button class="btn btn-primary btn-add-hub" can-click="createAndEditHub">Add Hub</button>
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Name</th>
					<th>Color Scheme</th>
					<th>Layout</th>
					<th>Connected Services</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{{#hubs}}
					<tr>
						<td>
							{{ name }}
						</td>
						<td>
							{{ colorscheme }}
						</td>
						<td>
							{{ layout}}
						</td>
						<td>
							{{#if services.isPending}}
								Loading...
							{{else}}
								{{#if services.length}}
									{{#isExpandedRow this}}
										<div class="expanded-services">
											<button class="btn btn-default btn-xs" can-click="toggleExpandedRow">Collapse</button>
											{{#each services}}
												<br>{{ printFeed }} &dash; {{ printType }} &dash; <small>( {{{ printConfig }}} )</small>
											{{/each}}
										</div>
									{{/else}}
										<button class="btn btn-default btn-xs" can-click="toggleExpandedRow">Expand</button>
										{{formatConnectedServices services}}
									{{/isExpandedRow}}
								{{else}}
									No connected services.
								{{/if}}
							{{/if}}
						</td>
						<td>
							<div class="btn-group">
								<a href="{{pageUrl 'sidebar' panel='services' hubId=id}}" class="btn btn-xs btn-default edit-hub-btn">Edit</button>
								<button class="btn btn-xs btn-default" can-click="destroyHub">Delete</button>
								<button class="btn btn-xs btn-default">Clone</button>
							</div>
						</td>
					</tr>
				{{/hubs}}
			</tbody>
		</table>
	{{else}}
		<div class="alert alert-info">You haven't created any hubs yet. <a href="javascript://" can-click="createAndEditHub">Create your first Hub &raquo;</a></div>
	{{/if}}
{{/if}}