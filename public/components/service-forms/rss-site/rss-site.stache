<div class="form-group">
	<label>URL</label>
	<input type="text" can-value="map.config.url" class="form-control">
	{{{configErrors errors 'url'}}}
</div>
<div class="form-group">
	<label>Tag with</label>
	<input type="text" can-value="map.config.tag_with" class="form-control">
	{{{configErrors errors 'tag_with'}}}
</div>