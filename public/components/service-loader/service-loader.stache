<article class="bit-container">
	<div class="bit">
		<div class="bit-content col-sm-12">
			<figcaption class="bit-content--caption">
				<h4>
					{{#if isLoading}}<i class="fa fa-spin fa-circle-o-notch"></i>{{/isLoading}}
					{{service.printFeed}} &dash; {{service.printType}}
				</h4>
				
				<p>{{{service.formattedConfig}}}</p>

				{{#service.error}}
					<div class="alert alert-danger">
						<b>{{ formattedErrorClass }}</b>
						{{ formattedError }}
					</div>
				{{/service.error}}

				{{#if service.noResults}}
					<div class="alert alert-info">
						We couldn't find any data on this service.
					</div>
				{{/if}}
				
			</figcaption>
		</div>
	</div>
</article>