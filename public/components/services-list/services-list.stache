{{#if services.isPending}}
	<i class="fa fa-spin fa-circle-o-notch"></i> Loading ...
{{else}}
	<table class="table">
		<tbody>
			{{#each services}}
				{{#isCurrentService this}}
					<tr>
						<td colspan="4">
							<bh-service-form service="{currentService}" state="{state}" services="{../services}"></bh-service-form>
						</td>
					</tr>
				{{else}}
					<tr>
						<td>{{ printFeed }} &dash; {{ printType }}</td>
						<td>
							{{{formatConfig config}}}
						</td>
						<td>
							<i can-click="destroyService" class="fa fa-close pull-right destroy-service"></i>
							<i can-click="editService" class="fa fa-pencil pull-right edit-service"></i>
						</td>
					</tr>
				{{/isCurrentService}}
			{{/each}}
		</tbody>
	</table>
{{/if}}