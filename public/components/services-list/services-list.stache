{{#if services.isPending}}

{{else}}
	<table class="table">
		<tbody>
			{{#each services}}
				<tr>
					<td>{{ printFeed }} &dash; {{ printType }} &dash; <small>( {{ printConfig }} )</small> <i can-click="destroyService" class="fa fa-close pull-right destroy-service"></i></td>
				</tr>
			{{/each}}
		</tbody>
	</table>
{{/if}}