<div class="row-fluid" id="filter-bar">

  <div class="span9">
    <div class="btn-toolbar">	  
      <div id="sortBy" class="btn-group">
        <a class="btn" href="#" <%= (el) -> el.data('sortby', 'top') %>>Top</a>
        <a class="btn" href="#" <%= (el) -> el.data('sortby', 'new') %>>New</a>
      </div>

      <div id="filterByFeed" class="btn-group">
        <button class="btn">All feeds</button>
        <button class="btn dropdown-toggle" data-toggle="dropdown">
          <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
          <li><a href="#" <%= (el) -> el.data('feed', '') %>> All feeds</a></li>
          <li><a href="#" <%= (el) -> el.data('feed', 'github') %>> Github</a></li>
          <li><a href="#" <%= (el) -> el.data('feed', 'twitter') %>>Twitter</a></li>
          <li><a href="#" <%= (el) -> el.data('feed', 'forums') %>>Forum</a></li>
          <li><a href="#" <%= (el) -> el.data('feed', 'blog') %>>Blog</a></li>
          <li><a href="#" <%= (el) -> el.data('feed', 'disqus') %>>Disqus</a></li>
        </ul>
      </div>

      <div id="filterByTimespan" class="btn-group">
        <button class="btn"><span>This week</span></button>
        <button class="btn dropdown-toggle" data-toggle="dropdown">
          <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
          <li><a href="#" <%= (el) -> el.data('timespan', 'day') %>>Today</a></li>
          <li><a href="#" <%= (el) -> el.data('timespan', 'week') %>>This week</a></li>
          <li><a href="#" <%= (el) -> el.data('timespan', 'month') %>>This month</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="span3">
    <div class="btn-toolbar pager">
	  <div class="btn-group">
        <a class="btn previous disabled" href="#">&larr;</a>
        <a class="btn" href="#"><%= eventCursor.attr('currentPage') %> / <%= eventCursor.attr('nmbOfPages') %></a>
        <a class="btn next" href="#">&rarr;</a>
	  </div>
    </div>
  </div>

</div><!-- /.row-fluid -->
