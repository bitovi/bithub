<div class="day" data-timestamp="<%= dayStr %>">

	<div class="sep-wrapper wrapper" style="height: 42px;">
	  <div class="sep blue">
		<h4 class="flag blue"><%= templateHelpers.formatForTitle(dayStr) %></h4>
	  </div>
	</div>

	<div class="category-feature" style="<%= templateHelpers.hideIfNone(eventsInDay['feature']) %>">
	  <h3 class="features-icon">Features</h3>
	  <div class="trucated">
		<% eventsInDay['feature'].map(function(event) { %>
		<%== can.view.render('/app/views/_event', {event: event}) %>
		<% }) %>
	  </div>
	</div>

	<div class="category-bug" style="<%= templateHelpers.hideIfNone(eventsInDay['bug']) %>">
	  <h3 class="bugs-icon">Bugs</h3>
	  <div class="truncated">
		<% eventsInDay['bug'].map(function(event) { %>
		<%== can.view.render('/app/views/_event', {event: event}) %>
		<% }) %>
	  </div>
	</div>

