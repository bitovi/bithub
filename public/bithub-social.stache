{{#if state.isSidebar}}

<div class="sidebar-wrap">
	<bh-sidebar state="{state}"{{#if state.sidebarIsExpanded}}class="is-expanded"{{/if}}></bh-sidebar>
</div>

<main id="content" class="container-fluid {{#if state.sidebarIsExpanded}}sidebar-is-expanded{{/if}}">
	{{#if state.bits}}
  	<bh-bits state="{state}" bits="{state.bits}"></bh-bits>
  {{/if}}
</main>

{{else}}

	<div class="container">
		<div class="row">
			<div class="col-xs-2"><h1>BitHub</h1></div>
			<div class="col-xs-10">
				<ul class="list-unstyled menu">
					<li>{{{pageLink 'hub-list' 'Hubs'}}}</li>
					<li>{{{pageLink 'payments' 'Payments'}}}</li>
					<li>{{{pageLink 'settings' 'Settings'}}}</li>
					<li>{{{pageLink 'users' 'Users'}}}</li>
					<li><a href="/logout" class="btn btn-link">Logout</a></li>
				</ul>
			</div>
		</div>
		<hr>
		<div class="content">
			{{{renderPage}}}
		</div>
	</div>

{{/if}}