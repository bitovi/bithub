<div class="top-bar">
  <div class="container">
    <div class="row">
      <div class="col-xs-12">
          <a href="#" class="logo">Bit<b>Hub</b></a>
          <div class="select-wrap">
            <select class="form-control input-sm"></select>
          </div>
          <div class="select-wrap">
            <select class="form-control input-sm"></select>
          </div>
      </div>
    </div>
  </div>

</div>
<div class="navigation">
  <div class="container">
    <div class="row">
      <div class="col-xs-12">
        <bh-edit-hub-name hub="{hub}"></bh-edit-hub-name>
        <a href="javascript://" class="add-edit-service-link" can-click="toggleServicesPanel">Add / Edit Service</a>
        <div class="main-navigation">
          <ul class="list-unstyled">
            <li {{#eq state.page "moderation"}}class="active"{{/eq}}>
              <a href='{{pageUrl "moderation"}}'>Moderation</a>
            </li>
            <li {{#eq state.page "publish"}}class="active"{{/eq}}>
              <a href='{{pageUrl "publish"}}'>Publish</a>
            </li>
            <li {{#eq state.page "analytics"}}class="active"{{/eq}}>
              <a href='{{pageUrl "analytics"}}'>Analytics</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<bh-empty-slate></bh-empty-slate>

{{#if showServicesPanel}}
  <div class="overlay">
    <div class="services-panel-wrap">
      <can-import from="components/services/">
        {{#eq state "resolved"}}
          <a href="javascript://" can-click="toggleServicesPanel">Close</a>
          <bh-services></bh-services>
        {{/eq}}
      </can-import>
    </div>
  </div>

{{/if}}
