    "body": "This pull request implements nested validations for the `can.Observe`. API is backward compatible, but adds new features.\r\n\r\n#### Validation of the nested property:\r\n\r\n    Person.validate('company.name', function(){\r\n        return 'company name validated from parent'\r\n    })\r\n\r\n    var person = new Person({company : {name : 'foo'}})\r\n\r\n    person.errors();\r\n\r\n    {'company.name' : [\r\n        'company name validated from parent'\r\n    ]}\r\n\r\n#### Validation of the nested property in combination with child objects validations:\r\n\r\n    Person.validate('company.name', function(){\r\n        return 'company name validated from parent'\r\n    })\r\n\r\n    Company.validate('name', function(){\r\n        return 'validation from company'\r\n    })\r\n\r\n    var person = new Person({company : {name : 'foo'}})\r\n\r\n    person.errors();\r\n\r\n    {'company.name' : [\r\n        'company name validated from parent',\r\n        'validation from company'\r\n    ]}\r\n\r\n    company.errors()\r\n\r\n    {'company.name' : [\r\n        'validation from company'\r\n    ]}\r\n\r\n#### Validation of the `can.Observe.List` members:\r\n\r\n    Person.validate('phoneNumbers.*', function(val, attr){\r\n        return val > 2 ? 'number too big' : null;\r\n    })\r\n\r\n    var person = new Person({phoneNumbers : [1,2,3]})\r\n\r\n    person.attr('phoneNumbers').push(4);\r\n\r\n    person.errors()\r\n\r\n    {\r\n        \"phoneNumbers.2\" : ['number too big'],\r\n        \"phoneNumbers.3\" : ['number too big'],\r\n    }\r\n\r\n#### Validation of the complex paths:\r\n\r\n    Person.validate('company.phoneNumbers.*.countryCode', function(val, attr){\r\n        if(val !== 1 && val !== 385){\r\n            return 'wrong country code'\r\n        }\r\n    })\r\n    var person = new Person;\r\n\r\n    person.attr('company', {\r\n        phoneNumbers : [{\r\n            number : 12345,\r\n            countryCode : 1\r\n        },{\r\n            number : 12345,\r\n            countryCode : 385\r\n        },{\r\n            number : 12345,\r\n            countryCode : 41\r\n        },{\r\n            number : 12345,\r\n            countryCode : 1\r\n        }]\r\n    });\r\n\r\n    person.errors()\r\n\r\n    {\r\n        'company.phoneNumbers.2.countryCode' : ['wrong country code']\r\n    }"
