        "patch_url": "https://github.com/bitovi/canjs/pull/427.patch"
    },
    "body": "This PR implements the `can.Model.Collection` plugin.\r\n\r\n`can.Model.Collection` combines params and list of items under one class which does two things:\r\n\r\n1. It reduces the amount of code needed to wire up filterable and sortable `findAll` requests\r\n2. It removes code related to the data loading from the controllers\r\n\r\nWithout the `can.Model.Collection` plugin, code would look like this:\r\n\r\n    var ImagesControl = can.Control({\r\n      init : function(){\r\n        this.options.params = new can.Observe;\r\n        this.on();\r\n        this.imagesList = new can.Observe.List\r\n    \r\n        this.element.html(someView({\r\n          imagesList : this.imagesList\r\n        }))\r\n    \r\n        this.loadData()\r\n      },\r\n      'a click' : function(el, ev){\r\n        this.options.params.attr('foo', 'bar');\r\n      },\r\n      \"{params} change\" : 'loadData',\r\n      loadData : function(){\r\n        ImageModel.findAll(this.options.params.serialize(), this.proxy('updateData'));\r\n      },\r\n      updateData : function(data){\r\n        this.imagesList.replace(data);\r\n      }\r\n    })\r\n\r\n`can.Model.Collection` shortens it to this:\r\n\r\n    var ImagesControl = can.Control({\r\n      init : function(){\r\n        this.imageCollection = new ImageModel.Collection;\r\n    \r\n        this.element.html(someView({\r\n          imagesList : this.imageCollection.list\r\n        }))\r\n    \r\n        this.imageCollection.load();\r\n      },\r\n      'a click' : function(el, ev){\r\n        this.imageCollection.params.attr('foo', 'bar');\r\n      }\r\n    })\r\n"
