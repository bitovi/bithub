<div class="pricing-wrap">
	<div class="caption">
		<img src="/site/images/lego/startup.png" alt="">
		<h3>Startup</h3>
		<h4>$99.00/month</h4>
		<% if context == 'frontpage' %>
			<div class="call-to-action">
				<a href="<%= current_account ? "/admin" : "/register/startup" %>" class="btn btn-info btn-block btn-large">Start your 15 - day trial</a>
			</div>
		<% end %>
		<ul class="list-unstyled">
			<li>1 Hub</li>
			<li>7 Unique Services</li>
			<li>Analytics</li>
			<li>Moderation</li>
			<li>Embed</li>
			<li><b>Live stream</b></li>
			<% if context == 'registration' %>
				<li><hr></li>
				<li><a href="/#registration">Pick a different plan</a></li>
			<% end %>
		</ul>
	</div>
</div>