<h2>Thank you for your payment!</h2>

<p>Charged amount: $<%= @billing.total / 100.0 %></p>
<p>Charged at: <%= @billing.charged_at.strftime("%B %d, %Y") %></p>
<p>Transaction number: <%= @billing.stripe_charge_id %></p>
<p>Number of published hubs: <%= @billing.monthly_billing_records.count %></p>

<h3>Published hubs:</h3>

<ul>
<% @billing.monthly_billing_records.each do |record| %>
	<li><%= record.description %> has been published for <%= pluralize(record.amount, 'day')%>.</li>
<% end %>
</ul>

<hr/>

<p>If you have any questions or concerns, please contact: <a href="mailto:support@bithub.com">support@bithub.com</a>.</p>

<p>Thank you,<br/>
The BitHub Team<br/>
<a href="http://bithub.com/">bithub.com</a></br>
</p>
