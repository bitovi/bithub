<h2 class="static-page-heading">Resend unlock instructions</h2>

<div class="panel panel-default">
	<div class="panel-body">
		<%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
			<%= devise_error_messages! %>

			<div class="form-group"><%= f.label :email %>
			<%= f.email_field :email, autofocus: true, class: 'form-control' %></div>

			<div><%= f.submit "Resend unlock instructions", class: 'btn btn-primary' %></div>
		<% end %>
	</div>
</div>


<%= render "devise/shared/links" %>
