<div class="panel panel-default">
  <div class="panel-heading">
	Update Credit Card Info
  </div>
  <div class="panel-body">

	<form action="/admin/subscriptions/update" method="POST" id="edit_cc">
	  <span class="payment-errors"></span>

	  <div class="form-group">
		  <label>Card Number
		    
		  </label>
      <input id="cc_number" type="text" size="20" data-stripe="number" class="form-control"/>
	  </div>

	  <div class="form-group">
		  <label>
		    CVC
		  </label>
      <input id="cc_cvc" type="text" size="4" data-stripe="cvc" class="form-control" style="width: 60px;"/>
	  </div>

	  <div class="form-row">
		  <label>Expiration (MM/YYYY)</label>
    <input id="cc_exp_month" type="text" size="2" data-stripe="exp-month" class="form-control" style="width: 50px; display: inline-block;"/> / 
		<input id="cc_exp_year" type="text" size="4" data-stripe="exp-year" class="form-control" style="width: 60px; display: inline-block;"/>
	  </div>
    <hr>
	  <button type="submit" class="btn btn-primary pull-right">Submit Card Info</button>
	</form>

  </div>
</div>


<%= stripe_javascript_tag %>

<script src="//ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>

<script type="text/javascript">
function stripeResponseHandler(status, response) {
  var $form = $('#edit_cc');

  if (response.error) {
    $form.find('.payment-errors').text(response.error.message);
    $form.find('button').prop('disabled', false);
  } else {
    var token = response.id;
    $form.append($('<input type="hidden" name="stripe_token" />').val(token));
    $form.get(0).submit();
  }
};

jQuery(function($) {
  $('#edit-cc').submit(function(event) {
    var $form = $(this);

    // Disable the submit button to prevent repeated clicks
    $form.find('button').prop('disabled', true);

    Stripe.card.createToken($form, stripeResponseHandler);

    // Prevent the form from submitting with the default action
    return false;
  });
});
</script>
