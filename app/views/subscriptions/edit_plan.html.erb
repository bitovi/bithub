<div class="panel panel-default">
  <div class="panel-heading">
	Choose New Plan
  </div>
  <div class="panel-body">

	<form action="/admin/subscriptions/update" method="POST" id="edit_plan">
	  <span class="choose-plan-errors"></span>

	  <div class="form-row">
		<label>
		  <span>Current plan: <%= @plan.name %></span>
		</label>
	  </div>

	  <div class="form-row">
		<label>
		  <span>Available plans:</span>
		  <select id="plan_id" name="plan">
			<% @plans.each do |p| %>
			<option value="<%= p.stripe_id %>" <%= (@plan.stripe_id == p.stripe_id) ? 'selected' : '' %>><%= p.name %></option>
			<% end %>
		  </select>
		</label>
	  </div>

	  <button type="submit">Submit</button>
	</form>

  </div>
</div>
