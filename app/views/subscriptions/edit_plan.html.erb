<div class="panel panel-default">
  <div class="panel-heading">
	Choose New Plan
  </div>
  <div class="panel-body">

	<form action="/admin/subscriptions/update" method="POST" id="edit_plan">
	  <span class="choose-plan-errors"></span>
    <h4>Current plan: <%= @plan.name %></h4>
	  
	  <div class="form-row">
		<label>Available plans</label>
    <select id="plan_id" name="plan" class="form-control">
			<% @plans.each do |p| %>
			<option value="<%= p.stripe_id %>" <%= (@plan.stripe_id == p.stripe_id) ? 'selected' : '' %>><%= p.name %></option>
			<% end %>
		  </select>
	  </div>
    <hr/>
	  <button type="submit" class="btn btn-primary pull-right">Save Plan</button>
	</form>

  </div>
</div>
