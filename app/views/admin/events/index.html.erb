<h1>Events</h1>

<table class="table table-stripped table-hover">
  <tr>
    <th>Title</th>
    <th>Category</th>
    <th>Feed</th>
    <th>Timestamp</th>
  </tr>

  <% @events.each do |e| %>
    <tr>
      <td><%= truncate(e.title) %></td>
      <td><%= e.category.name %></td>
      <td><%= e.feed.name %></td>
      <td><%= e.origin_ts %></td>
    </tr>
  <% end %>
</table>

<%= paginate @events %>
