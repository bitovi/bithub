(function(){


	var camelize = function(str){
		var r = /(\-|_|\s)+(.)?/g,
			f = function(m, s, c) { return c ? c.toUpperCase() : ''; },
			w = /\s+/g;
		return str.replace(r, f).replace(w, '');
	}

	/*!
	* domready (c) Dustin Diaz 2014 - License MIT
	*/

	var domready = function () {

		var fns = [], listener
		, doc = document
		, hack = doc.documentElement.doScroll
		, domContentLoaded = 'DOMContentLoaded'
		, loaded = (hack ? /^loaded|^c/ : /^loaded|^i|^c/).test(doc.readyState)


		if (!loaded)
			doc.addEventListener(domContentLoaded, listener = function () {
				doc.removeEventListener(domContentLoaded, listener)
				loaded = 1
				while (listener = fns.shift()) listener()
			})

		return function (fn) {
			loaded ? fn() : fns.push(fn)
		}

	};

	var makeIframe = function(link){
		var iframeSrc = link.href;
		var iframe = document.createElement('iframe');
		var parent = link.parentNode;

		iframe.src = iframeSrc;
		iframe.style.height = '100%';
		iframe.style.width = '100%';
		iframe.style.border = 'none';

		parent.replaceChild(iframe, link);

	}

	var hasClass = function(el, klass){
		var classes = el.className.split(' ');
		return classes.indexOf(klass) > -1;
	}

	domready()(function(){
		var hubLinks = Array.prototype.slice.call(document.getElementsByTagName('a'));

		for(var i = 0; i < hubLinks.length; i++){
			if(hasClass(hubLinks[i], 'bithub-embed')){
				makeIframe(hubLinks[i]);
			}
		}
	})

})();