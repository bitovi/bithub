<p><b>Name</b>: <%= @user.name %></p>
<p><b>Email</b>: <%= @user.email %></p>

<hr />

<h4>Activities</h4>
<% @user.activities.each do |act| %>
	<%= "nesto" %>
	<%= link_to "[x]", admin_user_activity(act), method: :delete %>
<% end %>

<hr />

<h5>New activity</h5>
<%= form_for @internal, url: admin_user_path(@user), method: :put do |f| %>
	<%= f.label :value %>
	<%= f.text_field :value %>
	<%= f.label :comment %>
	<%= f.text_area :comment, rows: 10, columns: 20 %>

	<%= f.submit "Modify user's points", { class: 'btn' } %>
<% end %>
