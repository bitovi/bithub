<h1>Tags</h1>
<%= link_to 'New tag', new_admin_tag_path, { class: 'btn' } %>

<table class="table table-stripped table-hover">
  <tr>
    <th>Name</th>
    <th>Display name</th>
    <th>Aliases</th>
  </tr>
 
<% @tags.each do |t| %>
  <tr>
    <td><%= link_to t.name, edit_admin_tag_path(t) %></td>
    <td><%= t.display_name %></td>
    <td><%= t.aliases %></td>
  </tr>
<% end %>
</table>

<%= paginate @tags %>
