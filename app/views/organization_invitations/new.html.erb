<h2 class="static-page-heading">Invite an account to organization: "<%= @invitation.organization.name %>"</h2>

<div class="panel panel-default">
	<div class="panel-body">

		<%= form_for(@invitation, url: organization_invitations_path) do |f| %>


			<%= flash['error'] %>


			<div class="form-group">
				Email: <%= email_field 'account', 'email', class: 'form-control' %>
			</div>


			<div>
				<%= submit_tag "Invite", class: 'btn btn-primary' %>
			</div>

		<% end %>
	</div>
</div>
