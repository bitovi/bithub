<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta http-equiv="content-type" content="text/html; charset=utf-8" />
	<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
	<title>BitHub | activity on our open-source projects</title>
	<link href="/bithub/production.css" rel="stylesheet" type="text/css">
</head>
<body>

	<div id="container">

		<div id="navbar" class="navbar">
			<div class="navbar-inner">
				<div class="container inner-navbar-container">
					<a class="brand" href="http://bitovi.<%= @domain %>">BitHub</a>
				</div>
			</div>
		</div>

		<div id="content" class="container content-container">
			<div id="pages" class="row" style="padding-top: 80px;">
				<div class="alert alert-notice" style="margin: 0 15px;">
					BitHub has moved! You can access it at the <a href="http://bitovi.<%= @domain %>">new location</a> or wait for us to forward you.
				</div>
			</div>
		</div>

	</div>
	<script>
		setTimeout(function(){
			window.location = "http://bitovi.<%= @domain %>";
		}, 10000)
	</script>

</body>
</html>
