json.cache! brand do
	json.(brand, :id, :name, :description, :keywords)

  json.acc ApplicationController.new.crypter.encrypt_and_sign(brand.id)
  json.set! :identities do
    json.array! BrandIdentityDecorator.decorate_collection(brand.identities) do |identity|
      json.partial! "api/v2/brand_identities/brand_identity", brand_identity: identity
    end
  end
end
