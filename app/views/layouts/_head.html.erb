<!doctype html>
<html>
<head>
	<meta charset="utf-8">

	<!-- Always force latest IE rendering engine or request Chrome Frame -->
	<meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">

	<!-- Use title if it's in the page YAML frontmatter -->
	<title>BitHub - Real time, embeddable, social hubs</title>
	<link href='http://fonts.googleapis.com/css?family=Raleway:400,700' rel='stylesheet' type='text/css'>
	<link href="/site/stylesheets/all.css" rel="stylesheet" type="text/css" />
	<script src="/site/javascripts/all.js" type="text/javascript"></script>
	<link rel="stylesheet" href="/site/video-js/video-js.min.css">
</head>

<body class="index">
	<div class="header">
		<div class="container <%= "text-container" if narrow %>">
			<div class="row">
				<div class="col-md-6">
					<a href="/"><img src="/site/images/logo.png" alt="BitHub" class="logo"></a>
					<h2>
						Real time, embeddable, social hubs
					</h2>
				</div>
				<div class="col-md-6">
					<ul class="list-unstyled">
						<% if current_account.nil? %>
							<li><a href="/login" class="login-link">Login</a></li>
							<li><span>or</span></li>
							<li><a href="#registration" class="btn btn-default btn-lg registration-btn">Start your trial!</a></li>
						<% else %>
							<li><a href="/logout" class="login-link">Logout</a></li>
							<li><span>or</span></li>
							<li><a href="/admin" class="btn btn-default btn-lg registration-btn">Go to Admin</a></li>
						<% end %>
					</ul>
				</div>

			</div>
			<div class="row">
				<div class="col-xs-12">
					<hr>
				</div>
			</div>

		</div>
	</div>