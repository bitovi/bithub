<!doctype html>
<html>
<head>
	<meta charset="utf-8">

	<!-- Always force latest IE rendering engine or request Chrome Frame -->
	<meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">

	<!-- Use title if it's in the page YAML frontmatter -->
	<title>BitHub - Real time, embeddable, social hubs</title>
	<link href='http://fonts.googleapis.com/css?family=Raleway:400,700' rel='stylesheet' type='text/css'>
	<link href="/site/stylesheets/all.css" rel="stylesheet" type="text/css" />
	<script>
	(function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
		(i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
		m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
	})(window,document,'script','//www.google-analytics.com/analytics.js','ga');

	ga('create', 'UA-2302003-18', 'auto');
	ga('send', 'pageview');

</script>
</head>

<body class="index">
	<div class="top-bar-cta">
		<div class="container">
			<div class="row">
				<div class="col-xs-12">
					<div class="top-cta-wrap">
						Subscribe to our newsletter and receive special offers by BitHub! <a class="btn btn-primary subscribe-to-newsletter" href="javascript://">Subscribe Now</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="header">
		<div class="container <%= "text-container" if narrow %>">
			<div class="row">
				<div class="col-md-6">
					<a href="/"><img src="/site/images/logo.png" alt="BitHub" class="logo"></a>
					<h2>
						Real time, embeddable, social hubs
					</h2>
				</div>
				<div class="col-md-6">
					<ul class="list-unstyled">
						<% if current_account.nil? %>
						<li><a href="/login" class="login-link">Login</a></li>
						<li><span>or</span></li>
						<li><a href="/#registration" class="btn btn-default btn-lg registration-btn">Start your trial!</a></li>
						<% else %>
						<li><a href="/logout" class="login-link">Logout</a></li>
						<li><span>or</span></li>
						<li><a href="/admin" class="btn btn-default btn-lg registration-btn">Go to Admin</a></li>
						<% end %>
					</ul>
				</div>

			</div>
			<div class="row">
				<div class="col-xs-12">
					<hr>
				</div>
			</div>

		</div>
	</div>