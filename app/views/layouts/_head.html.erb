<!doctype html>
<html>
  <head>
    <meta charset="utf-8">

    <!-- Always force latest IE rendering engine or request Chrome Frame -->
    <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <!-- Use title if it's in the page YAML frontmatter -->
    <title>BitHub</title>

    <%= stylesheet_link_tag "all" %>
    <script src="//code.jquery.com/jquery-1.11.3.min.js"></script>
    <%= javascript_include_tag  "all" %>
  </head>

  <body class="<%= local_assigns.fetch :body_classes, "" %>">
    <div class="register-user-overlay">
      <div class="register-user-wrap">
        <button class="close-registration-overlay"><img src="/images/site/bithub-site_close-icon.svg"></button>
        <div class="get-started-title">Get Started with Bit<b>Hub</b></div>
        <%#
        <p>Sign Up With Social:</p>
        <div class="social-icons">
          <img alt="" src="/images/site/bithub-site_social-facebook.svg">
          <img alt="" src="/images/site/bithub-site_social-instagram.svg">
          <img alt="" src="/images/site/bithub-site_social-twitter.svg">
        </div>
        <hr>
        %>
        <p>Sign up With Email:</p>
        <form action="/users" method="post">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input name="utf8" type="hidden" value="✓">
          <input type="email" placeholder="Your Email" name="user[email]">
          <input type="password" placeholder="Choose a password" name="user[password]">
          <input type="password" placeholder="Confirm your password" name="user[password_confirmation]">
          <button>Create Free User</button>
        </form>
      </div>
    </div>
    <div class="sidebar-menu sm">
      <nav>
        <ul>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </nav>
    </div>
    <div class="outer-container">
      <div class="page-container">
        <header class="site-header">
          <button class="hamburger sm"><span>Menu</span></button>
          <div class="menu-wrap">
            <h1><a href="/">Bit<b>Hub</b></a></h1>
            <div class="main-menu lg">
              <nav>
                <ul>
                  <li><a href="/faq">FAQ</a></li>
                  <li><a href="/pricing">Pricing</a></li>
                </ul>
              </nav>
            </div>
            <div class="header-menu">
              <span class="lg">Starting at <b>$7 per month!</b></span>
              <a href="/login" class="sign-in">Log in</a>
              <a href="#" class="try-it-now">Try It Now!</a>
            </div>
          </div> 
          
        </header>
