<%= render partial: "layouts/head", :locals => {:narrow => false}  %>

<div class="container page-content">
	<div class="row">
		<div class="col-xs-3">
			<ul class="list-unstyled sidebar-menu">
				<% static_pages.each do |page, name| %>
					<li class="<%= 'active' if current_page?(controller: 'static_pages', action: 'render_page', page: page)%>">
						<%= link_to name, controller: "static_pages", action: 'render_page', page: page %>
					</li>
				<% end %>
			</ul>
		</div>
		<div class="col-xs-9 static-page-content">
			<h2 class="static-page-heading"><%= @current_page_title %></h2>
			<%= yield %>
		</div>
	</div>
</div>

<%= render partial: "layouts/footer", :locals => {:narrow => false} %>
